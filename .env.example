MP_ACCESS_TOKEN=PEGAR_AQUI_TOKEN_PRIVADO_DE_MERCADO_PAGO

# Recuperación de contraseña por correo. Para Gmail, usar una contraseña de aplicación.
# En desarrollo local (localhost) sin SMTP, el código se muestra en la pantalla de recuperación.
# En producción, SMTP es obligatorio y el código nunca se devuelve en la respuesta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=pcgamershop.oficial@gmail.com
SMTP_APP_PASSWORD=PEGAR_AQUI_LA_CONTRASENA_DE_APLICACION_DE_GMAIL
SMTP_FROM=PC Gamer Shop <pcgamershop.oficial@gmail.com>
